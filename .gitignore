# Virtual environment
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.backup

# Log files
*.log
app.log

# Storage directories (keep structure, ignore contents)
app/storage/data/*
!app/storage/data/.gitkeep
app/storage/uploads/*
!app/storage/uploads/.gitkeep
app/storage/temp/*
!app/storage/temp/.gitkeep
app/storage/ai_models/*
!app/storage/ai_models/.gitkeep
app/storage/temp/*
!app/storage/temp/.gitkeep

# Asset directories — app assets (icons, images, templates) are committed.
# Only exports/ is generated at runtime and should be ignored.
app/assets/exports/*
!app/assets/exports/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Ignore GitHub configuration files
.github/

# Coverage reports
.coverage